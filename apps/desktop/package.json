{
  "name": "@strand/desktop",
  "productName": "Strand",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "description": "An unofficial multi-account client for Threads on macOS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extrastu/Strand.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "package": "electron-vite build && node scripts/package.mjs",
    "package:dmg": "electron-vite build && node scripts/package.mjs --dmg",
    "package:zip": "electron-vite build && node scripts/package.mjs --zip",
    "dist": "electron-vite build && node scripts/package.mjs --all",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^33.4.11",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}

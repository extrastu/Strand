{
  "name": "strand-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Monorepo for Strand: unofficial macOS Threads client and official web portal",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:desktop": "npm run dev -w @strand/desktop",
    "dev:web": "npm run dev -w @strand/web",
    "build:desktop": "npm run build -w @strand/desktop",
    "build:web": "npm run build -w @strand/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:desktop": "npm run test -w @strand/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:desktop": "npm run typecheck -w @strand/desktop",
    "typecheck:web": "npm run typecheck -w @strand/web",
    "package:dmg": "npm run package:dmg -w @strand/desktop",
    "package:zip": "npm run package:zip -w @strand/desktop",
    "dist": "npm run dist -w @strand/desktop"
  },
  "engines": {
    "node": ">=22.12"
  }
}
